#body {
    padding: 0 1;
}

#toolbar {
    height: auto;
    align: right middle;
    padding: 1 0 0 0;
}

#config-path {
    width: 1fr;
    color: $text-muted;
}

/* Fixed width so the label flipping between "Save" and "Saved ☑️" cannot shift the
   layout: the emoji's rendered cell width varies between terminals. */
#save {
    width: 14;
    min-width: 14;
}

/* Both cell classes are height 1 to match the row; a taller child would be clipped away
   entirely rather than overflowing visibly. */
#column-headings {
    height: 1;
    margin: 1 0 0 0;
}

#column-headings .heading-name {
    width: 24;
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#column-headings .heading {
    width: 34;
    height: 1;
    content-align: center middle;
    color: $text-muted;
    text-style: bold;
}

.project-row {
    height: auto;
    padding: 0 0 1 0;
}

.project-name {
    width: 24;
    content-align: left middle;
    height: 3;
    padding: 1 0 0 0;
}

.deploy {
    width: 34;
    min-width: 34;
}

#rows {
    height: 1fr;
}

#output {
    height: 10;
    border: round $panel;
    padding: 0 1;
}

/* Confirmation dialog */

/* The gutter lives on the screen rather than the dialog so that the dialog can simply ask
   for all the width it is allowed: 100% resolves against the screen's content region,
   which is the terminal minus this padding. */
ConfirmDeployScreen {
    align: center middle;
    padding: 0 4;
}

.confirm {
    width: 100%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

.confirm.prod {
    border: heavy $error;
}

.confirm-title {
    text-style: bold;
    padding: 0 0 1 0;
}

.confirm.prod .confirm-title {
    color: $error;
}

.confirm-warning {
    background: $warning-muted;
    padding: 1;
    margin: 0 0 1 0;
}

/* Every modal's scrolling region is `1fr`, never `auto` with a `1fr` cap. Under `auto` the
   region asks for its content height and the cap under-reserves once `max-height: 90%`
   clamps the dialog, so the docked footer is drawn over the last rows of the content —
   between two and five of them, depending on the screen. Those rows were unreachable: not
   scrollable into view, and not clickable. `1fr` divides the space that is actually left,
   which costs a dialog that no longer shrinks to short content. */
.confirm-body {
    height: 1fr;
}

/* The sha in each commit line is an action link. Underlining it is the only affordance
   that it can be clicked, since a terminal has no cursor to change shape. */
.confirm-commit {
    link-color: $accent;
    link-style: underline;
    link-background-hover: $accent;
    link-color-hover: $text;
    link-style-hover: underline;
}

.confirm-dry {
    height: auto;
    max-height: 10;
    margin: 1 0 0 0;
}

/* Docked as one unit so the body's `1fr` reserves the whole footer, not just the buttons.
   The button row inside it must not dock again, or it would leave the footer's flow and
   stop contributing its rows to the reservation. */
.confirm-footer {
    dock: bottom;
    height: auto;
}

.confirm-footer .confirm-buttons {
    dock: none;
}

/* All three modals dock this row, which is what stops a long body pushing the buttons past
   the bottom edge of a short terminal. It pairs with the `1fr` bodies above: docking alone
   hides the content under the buttons, and `1fr` alone lets the buttons be pushed away. */
.confirm-buttons {
    dock: bottom;
    height: auto;
    align: right middle;
    padding: 1 0 0 0;
}

.confirm-buttons Button {
    margin: 0 0 0 2;
}

/* Commit detail */

CommitDetailScreen {
    align: center middle;
    padding: 0 4;
}

.commit-detail {
    width: 100%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

/* `1fr`, not `auto`: see the note on .confirm-body. */
.commit-detail-body {
    height: 1fr;
}

/* Settings dialog */

SettingsScreen {
    align: center middle;
}

.settings {
    width: 92;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

.settings-note {
    color: $text-muted;
    padding: 0 0 1 0;
}

/* `1fr`, not `auto`: see the note on .confirm-body. */
.settings-body {
    height: 1fr;
}

.settings-project {
    text-style: bold;
    padding: 1 0 0 0;
}

.settings-fields {
    height: auto;
}

.settings-label {
    width: 8;
    content-align: left middle;
    height: 3;
    padding: 1 0 0 0;
}

.settings-input {
    width: 1fr;
}

.settings-remote {
    width: 24;
}
